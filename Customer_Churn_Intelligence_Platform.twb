      <aliases enabled='yes' />
      <column caption='Cltv' datatype='integer' name='[CLTV]' role='measure' type='quantitative' />
      <column caption='Total Customers' datatype='integer' name='[Calculation_0461977115205633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Tenure Months])' />
      </column>
      <column caption='Actual Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_0461977116434435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [Actual Churn] = &quot;Yes&quot; THEN 1 ELSE 0 END&#10;)&#10;/&#10;COUNT([Tenure Months])' />
      </column>
      <column caption='High Risk Customers' datatype='integer' name='[Calculation_0461977118711812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Risk Category] = &quot;High Risk&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Tenure Band' datatype='string' name='[Calculation_0461977457987589]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tenure Months] &lt;= 12 THEN &quot;0–12 Months&quot;&#10;ELSEIF [Tenure Months] &lt;= 24 THEN &quot;13–24 Months&quot;&#10;ELSEIF [Tenure Months] &lt;= 36 THEN &quot;25–36 Months&quot;&#10;ELSEIF [Tenure Months] &lt;= 48 THEN &quot;37–48 Months&quot;&#10;ELSEIF [Tenure Months] &lt;= 60 THEN &quot;49–60 Months&quot;&#10;ELSE &quot;61–72 Months&quot;&#10;END' />
      </column>
      <column datatype='string' name='[Risk Category]' role='dimension' type='nominal' />
